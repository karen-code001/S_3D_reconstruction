# Control plane
CONTROL_DATABASE_URL=postgresql+psycopg://reconstruction:replace-me@127.0.0.1/reconstruction
CONTROL_UPLOAD_TOKEN_SECRET=replace-with-a-long-random-secret
CONTROL_INTERNAL_API_KEY=replace-with-an-independent-random-key
CONTROL_CORS_ORIGINS=null, http://localhost:5173, http://127.0.0.1:5173

# One transfer node (use a separate file or environment per machine)
TRANSFER_NODE_ID=transfer-1
TRANSFER_PUBLIC_URL=https://transfer-1.example.com
TRANSFER_CALLBACK_URL=https://transfer-1.internal.example.com
TRANSFER_CONTROL_PLANE_URL=https://control.internal.example.com
TRANSFER_UPLOAD_TOKEN_SECRET=replace-with-the-same-upload-token-secret
TRANSFER_INTERNAL_API_KEY=replace-with-the-same-internal-api-key
TRANSFER_STORAGE_ROOT=./data/transfer-1
TRANSFER_CORS_ORIGINS=null, http://localhost:5173, http://127.0.0.1:5173
TRANSFER_COMPUTE_NODES=gpu-1|https://gpu-1.internal.example.com|1,gpu-2|https://gpu-2.internal.example.com|1

# One compute node (use a separate file or environment per machine)
COMPUTE_NODE_ID=gpu-1
COMPUTE_STORAGE_ROOT=./data/compute-1
COMPUTE_CAPACITY=1
COMPUTE_MAX_UPLOAD_BYTES=21474836480  #20GB
COMPUTE_CALLBACK_TIMEOUT_SECONDS=30